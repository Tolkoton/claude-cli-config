.cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

.claude/settings.local.json

# Overseer recursion guards — per-machine, per-session SHA caches.
# Ephemeral by design (see .claude/README.md §3); tracking them would
# replay one machine's guard state onto another.
.claude/overseer/.last_audit_sha
.claude/overseer/.last_continue_sha

# Unattended-run machine-local state. Regenerated every run; committing it
# would replay one machine's cost counter and restart history onto another.
.claude/unattended/state.json
.claude/unattended/cost.json
.claude/unattended/heartbeat
.claude/unattended/restarts.log
.claude/unattended/sim-plan.txt
.claude/unattended/logs/
.claude/unattended/archive/
.claude/overseer/mode
PROGRESS.md
.claude/unattended/supervisor.lock
.claude/overseer/.continue_count
# Complexity gate: the limits a slice began with, and the last report. Machine state.
.claude/overseer/.budget-*.json
.claude/overseer/complexity-report.md
HANDOFF-*.md
