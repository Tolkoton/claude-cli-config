# .claude/project.env — Project-specific hook configuration.
#
# Fill in when embedding this template in a new project.
# All values are optional — see the "Default" note for each.
# Hooks source this file at runtime; no restart needed after editing.
#
# See docs/TEMPLATE-SETUP.md for the full setup guide.

# ---------------------------------------------------------------------------
# SOURCE CODE LOCATION
# ---------------------------------------------------------------------------

# SOURCE_DIRS — dirs that contain source code (relative to project root).
# An Edit/Write inside one of these dirs counts as the "code edit" half of
# the overseer unit-completion trigger. Space- or comma-separated — both
# "backend/src frontend/src" and "backend/src,frontend/src" work.
#
# Default (empty): any file matching CODE_EXTENSIONS counts, regardless of dir.
# Example for a monorepo: SOURCE_DIRS="backend/src frontend/src"
SOURCE_DIRS="src"

# CODE_EXTENSIONS — file extensions that identify code files. Space- or
# comma-separated, leading dots optional — "ts tsx", "ts,tsx", and ".ts,.tsx"
# all parse the same way. Used by verify-on-stop.sh (skip heavy checks if no
# matching files changed) and as the fallback for overseer_stop.py when
# SOURCE_DIRS is empty.
# Guarded: a change of this value blocks the gate unless the sealed slice contract carries
# `gate-allow: CODE_EXTENSIONS — <reason>` (.claude/references/gate.md).
#
# Default (empty): treat ALL changed files as code — always attempt verification.
# Example for TypeScript: CODE_EXTENSIONS="ts tsx"
CODE_EXTENSIONS="py"

# ---------------------------------------------------------------------------
# OVERSEER TRIGGER
# ---------------------------------------------------------------------------

# CHECK_CMDS — command names that count as a "verification run" for the
# overseer unit-completion trigger (the second half of the two-signal check).
# Space- or comma-separated — "vitest nx" and "vitest,nx" both work.
#
# Default (empty): built-in broad set covers pytest ruff mypy npm jest
#                  go cargo swift — no configuration needed for common stacks.
# Example to add a custom runner: CHECK_CMDS="vitest nx"
CHECK_CMDS=""

# ---------------------------------------------------------------------------
# VERIFICATION (verify-on-stop.sh)
# ---------------------------------------------------------------------------

# PROJECT_MARKER — a file that must exist before verification runs.
# Prevents dry-fire on first clone before tooling is installed.
# It holds back lint, types and tests only: the bypass guard needs no tooling and runs anyway.
# Guarded: a change of this value blocks the gate unless the sealed slice contract carries
# `gate-allow: PROJECT_MARKER — <reason>` (.claude/references/gate.md).
#
# Default (empty): always run verification when code files change.
# Python example: PROJECT_MARKER="pyproject.toml"
# JS example:     PROJECT_MARKER="package.json"
PROJECT_MARKER=""

# LINT_CMD — lint command to run after code changes.
# Empty → Python auto-detect (ruff check, if pyproject.toml has [tool.ruff]).
# Set to skip entirely: LINT_CMD="true"
# Example: LINT_CMD="npm run lint"
LINT_CMD=""

# TYPECHECK_CMD — type-check command.
# Empty → Python auto-detect (mypy, if pyproject.toml has [tool.mypy]).
# Example: TYPECHECK_CMD="npx tsc --noEmit"
TYPECHECK_CMD=""

# TEST_CMD — test command.
# Empty → Python auto-detect (pytest -x, if tests/ or test/ dir exists).
# Example: TEST_CMD="npm test"
TEST_CMD=""

# The four commands above are the Stop layer of .claude/hooks/gate.py (verify-on-stop.sh calls
# it). With the three check commands empty the gate runs ruff and mypy on the files the turn
# changed, and pytest on their tests. Changing LINT_CMD, TYPECHECK_CMD, TEST_CMD, TEST_CMD_FULL,
# FORMAT_CMD or GATE_MAX_BLOCKS counts as touching the gate: the bypass guard blocks the change
# unless a line `# gate-allow: <reason>` stands among the added lines (details:
# .claude/references/gate.md).

# A PROJECT THAT ALREADY HAS FAILING TESTS OR LINT FINDINGS (code that did not start with the
# engine): the owner runs, in their own terminal, `python3 .claude/hooks/baseline.py record`. It
# writes .engine/baseline.json — the tests that fail today and the number of lint and type
# findings per file and rule — and from then on the gate blocks only what got WORSE. There is no
# key for it here: the file is the switch, and without it the gate asks for clean. For the
# snapshot to be readable the commands above must name what fails — `FAILED <test>` lines,
# `<file>:<line>: <message>` lines — and TEST_CMD must not stop at the first failure (no `-x`).
# Only the owner's `record` may add to the snapshot; `baseline.py tighten` shrinks it.

# TEST_CMD_FULL — the test command of the full layers (pre_commit and ci). Empty → TEST_CMD.
# Use it when TEST_CMD is a fast subset for the Stop gate.
TEST_CMD_FULL=""

# GATE_MAX_BLOCKS — how many Stop blocks in a row (per session) before the gate lets the turn
# end and parks the item for a human. Empty → 3.
GATE_MAX_BLOCKS=""

# ---------------------------------------------------------------------------
# THE DELETE GUARD (delete_guard.py, called by gate.py)
# ---------------------------------------------------------------------------

# DELETE_GUARD_LINES — the gate blocks a change that deletes a function, a class or a file of
# working code no test touched, or more than this many lines inside one function
# (.claude/references/gate.md, "The delete guard"). A starting value, to be calibrated on the
# project's history. Empty or unset → 20.
# Guarded: a change of this value blocks the gate unless the sealed slice contract carries
# `gate-allow: DELETE_GUARD_LINES — <reason>`.
DELETE_GUARD_LINES="20"

# COVERAGE_CMD — makes "did a test touch this code" exact. The command is run in a clean checkout
# of the code BEFORE the change (then, if needed, with the change's test files laid over it) and must leave
# `coverage.json` in the working directory, in the format of coverage.py's `coverage json`.
# Empty → the coarser check: the module has its test file, or a test file mentions the name.
# Guarded like the gate's other commands: a change needs its reason beside it (gate.md).
# Example: COVERAGE_CMD="coverage run -m pytest -q; coverage json -o coverage.json"
COVERAGE_CMD=""

# ---------------------------------------------------------------------------
# FORMATTING (format-on-edit.sh)
# ---------------------------------------------------------------------------

# FORMAT_CMD — command to auto-format a code file after an edit.
# Use {file} as the placeholder for the file path.
# Empty → Python auto-detect (ruff format + ruff check --fix --select I).
# Example for JS/TS: FORMAT_CMD="npx prettier --write {file}"
# To disable formatting: FORMAT_CMD="true"
FORMAT_CMD=""

# ---------------------------------------------------------------------------
# COMPLEXITY BUDGET (complexity_budget.py)
# ---------------------------------------------------------------------------

# COMPLEXITY_GATE — the deterministic layer of the simplifier. A slice contract may carry a
# "## Complexity budget" section (see .claude/references/complexity-budget.md); at the end
# of a turn everything changed since the slice began is measured against it. The budget is an
# expectation, not a ceiling: going over it calls the simplifier (.claude/references/simplifier.md).
#   off    no measuring, no signals, no budget step in /plan-slice. Exactly as without it.
#   warn   never holds the turn; writes .claude/state/overseer/complexity-report.md, and gate.py
#          shows the simplifier's signals as warnings. Use it for a week on real work first.
#   call   an overrun holds the turn until the simplifier's verdict is recorded
#          (`simplifier.py accept`) or the change is made smaller. `block` means the same.
# Default (empty or off): off.
COMPLEXITY_GATE="off"

# COMPLEXITY_MAX_CYCLOMATIC, COMPLEXITY_MAX_NESTING — the project's default per-function limits:
# what the signals measure a new or worsened function against, and what a contract that names
# no such limit gets. Unset: 10 and 3. `python3 .claude/hooks/complexity_budget.py calibrate`
# proposes them from the functions the project already has; the OWNER applies them with
# `... set-defaults <cyclomatic> <nesting>` (refused inside a session; a change of either key
# by the work being judged is stopped by the gate's bypass guard).

# SIMPLIFIER_PROTECTED — paths the simplifier may never remove from automatically, on top of the
# built-in list (constitution, settings, deny hooks, migrations, CI workflows, lock files,
# baselines, fixtures). Space- or comma-separated globs: "vendor/** docs/legal/**".
SIMPLIFIER_PROTECTED=""

# SIMPLIFY_EXCLUDE — directories or files inside SOURCE_DIRS the signals do not measure: fixtures,
# generated or vendored code. Space- or comma-separated paths.
SIMPLIFY_EXCLUDE=""

# SECOND_OPINION — a second, different model (Gemini) looks at every simplifier finding before
# `route` (.claude/hooks/second_opinion.py; .claude/references/simplifier.md). It can only lower
# what a finding may do. Switching it on SENDS EXCERPTS OF THE PROJECT'S CODE TO GOOGLE: the
# target file of each finding and the lines where its names occur.
#   off   nothing is sent; the simplifier works exactly as without it.
#   on    needs the key in the environment variable GEMINI_API_KEY_SIMPLIFIER (a paid-tier key
#         of its own, with a spending limit in the Google console; never in a file of the
#         repository). While on, a finding without an agreeing answer is never removed
#         automatically — a service that is down means "no removal without a human today".
# Default (empty or anything but on): off.
SECOND_OPINION="off"

# SECOND_OPINION_MODEL and its prices in USD per million tokens (input; output, thinking
# included). Prices change: reread https://ai.google.dev/gemini-api/docs/pricing before
# switching on. Without the two prices nothing is asked, because the limit below could not be kept.
# Read 2026-10-03, paid tier, standard, prompts up to 200k tokens.
SECOND_OPINION_MODEL="gemini-3.1-pro-preview"
SECOND_OPINION_PRICE_IN="2.00"
SECOND_OPINION_PRICE_OUT="12.00"

# SECOND_OPINION_MAX_USD — the most one pass (`second_opinion.py review`) may spend; the
# findings left after that get `no_opinion`. Empty → 2.
SECOND_OPINION_MAX_USD="2"

# ---------------------------------------------------------------------------
# COMMIT POLICY IN A CLOUD SESSION (block-dangerous.sh, commit_checkpoint.sh)
# ---------------------------------------------------------------------------

# CLOUD_COMMIT_POLICY — what a Claude Code CLOUD session (CLAUDE_CODE_REMOTE=true) may
# commit. Locally the rule is fixed: refused everywhere except an unattended/* branch.
#   off             a cloud session may not commit either (the shipped default).
#   session-branch  a cloud session may commit on the branch it checked out, except a
#                   protected one (main, master, production, prod, release).
# Flip it only after running .claude/unattended/env-probe.sh in a real cloud session
# and reading what it prints about the branch and the remote.
# Default (empty or unknown value): off.
CLOUD_COMMIT_POLICY="off"
