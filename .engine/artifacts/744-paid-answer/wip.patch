diff --git a/.claude/unattended/board.py b/.claude/unattended/board.py
index 096c5de..24e7807 100755
--- a/.claude/unattended/board.py
+++ b/.claude/unattended/board.py
@@ -22,7 +22,9 @@ exception reads only: `review` takes the board from the work branch in origin (b
                                      of the same side: see AN ATTENDED TASK)
     board.py where <NNN-name>        todo | doing | blocked | done | missing
     board.py import-inbox <dir>      take new task files in (see `import_inbox`)
-    board.py unblock                 blocked/ tasks whose every answer is filled go back to todo/
+    board.py unblock                 blocked/ tasks whose every answer is filled go back to todo/ — but
+                                     one whose answer says «Платні прогони: так» while its header gives
+                                     no leave stays, with a question how to give it (A LEAVE IN AN ANSWER)
     board.py audit-allowed           exit 0 only when this session's task in doing/ asks for the audit
     board.py gate-answers            the gate's questions in blocked/ that the owner answered
                                      «так»: one `name<TAB>stamp<TAB>sha256` line each
@@ -122,6 +124,17 @@ task is in hand» — the paid-run checks, the overseer's unit key, a hook's jou
 its own side's (`own`, board 712): an agent alone the plain one, the owner's session the attended
 one, or the plain one when no attended task is there.
 
+A LEAVE IN AN ANSWER (board 744). The owner's leave for paid runs is read from one line in the
+task's header and nowhere else, so «Платні прогони: так» written into an answer opens nothing; twice
+such a task went back to the queue, the run was refused, and the same question came back. Now
+`unblock` keeps such a task in blocked/ (an answer written after the last such note says it, and the
+header still has no leave) and appends one more question — the board's note: what to do with the
+header (add the line; or change the one there, «ні» → «так», since a template task has one already
+and two lines are no leave; or keep one of several), «додано» when it is done, «без них» when no paid
+run is wanted. «додано» while the header still gives no leave brings a new note, saying what is wrong
+with it; any other answer returns the task to the agent, without leave. The board never writes the
+leave itself: the line in the header stays the owner's.
+
 THE OWNER'S ANSWERS FIRST (board 049). A task the owner has just answered does not go to the end
 of the queue, whatever its number — a gate question is numbered from 900. `unblock` appends the
 names it returns to todo/ to `tasks/.first`, one per line; `next` takes the tasks named there
@@ -201,6 +214,8 @@ GATE = re.compile(r"^Ескалація (?:gates|воріт):\s*(\S+)", re.MULTI
 COUNT_WORDS = {2: "двох", 3: "трьох"}
 GATE_FIRST = 900  # the gate's questions are numbered from here, past the owner's own tasks
 CONSENT = "так"  # the one form of the owner's consent (board 036): see `consents`
+PAID_ANSWER = re.compile(r"Платні прогони:[\s*_`]*так(?!\w)", re.IGNORECASE)   # the leave, written in an answer (board 744)
+PAID_NOTE = "Примітка task board про платні прогони"
 # What the runner may do on the owner's «так». `close-escalation` is offered by the gate's own
 # question (the `Ескалація gates:` line), the rest by an action line.
 OWNER_ACTIONS = ("apply-settings", "promote-rule", "amend-goals", "update-deps", "close-escalation")
@@ -566,12 +581,56 @@ def duplicates(board: Board) -> list[str]:
     return duplicate_lines({c: [p.name for p in (board.done() if c == "done" else board.files(c))] for c in COLUMNS})
 
 
+def leave_problem(task: Task) -> str:
+    """Why the board keeps an answered task in blocked/ over a leave for paid runs (A LEAVE IN AN
+    ANSWER), or "": `answer` — «Платні прогони: так» stands in an answer written after the board's
+    last note; `added` — the owner answered the last note «додано», yet the header still gives no
+    leave. Never when the header gives it."""
+    if task.paid:
+        return ""
+    noted, _, after_note = task.questions.rpartition(PAID_NOTE)
+    answers = [a.strip() for a in ANSWER.findall(after_note)]
+    if noted and answers and is_word(answers[-1], "додано"):
+        return "added"
+    return "answer" if any(PAID_ANSWER.search(answer) for answer in answers) else ""
+
+
+def where_leave_goes(header: str) -> str:
+    """What to do with the header for the leave to be read: add the line, change the one there, or
+    keep one of several — the guard reads exactly one line (`paid_leave`)."""
+    lines = [m.group(1).strip() for m in PAID.finditer(header)]
+    if not lines:
+        return "допишіть угорі цієї задачі, під «Аудит потрібен:», окремий рядок `Платні прогони: так`"
+    if len(lines) == 1:
+        return (f"угорі цієї задачі вже стоїть рядок `Платні прогони: {lines[0]}` — замініть у ньому «{lines[0]}» на «так»; "
+                "другого такого рядка не дописуйте")
+    return f"угорі цієї задачі рядків «Платні прогони:» — {len(lines)}, а дозвіл читається лише з одного: лишіть один, `Платні прогони: так`"
+
+
+def leave_note(path: Path, task: Task, problem: str) -> None:
+    """The board's question under such an answer: what to do with the header, and what to answer."""
+    text = path.read_text(encoding="utf-8").rstrip("\n")
+    first = HEADING.search(COMMENT.sub("", text))
+    header = COMMENT.sub("", text)[: first.start()] if first else text
+    said = ("ви відповіли «додано», але вгорі задачі дозволу на платні прогони досі немає" if problem == "added" else
+            "у відповіді вище стоїть «Платні прогони: так», але згоду на платні прогони task board читає лише з рядка вгорі "
+            "задачі, — у відповіді вона нічого не відкриває")
+    path.write_text(text + f"\n{len(task.answers) + 1}. {PAID_NOTE}: {said}, тому задача не повернулась у чергу. Якщо це згода — "
+                    f"{where_leave_goes(header)} і напишіть тут «додано». Якщо платних прогонів не треба — напишіть тут «без них» "
+                    "(будь-яка інша відповідь теж поверне задачу агентові, без дозволу). Решту ваших відповідей агент отримає, як є."
+                    "\n   Відповідь:\n", encoding="utf-8")
+
+
 def unblock(board: Board) -> list[str]:
     moved: list[str] = []
     for path in board.files("blocked"):
         task = read(path)
         # A gate question answered «так» is closed by the runner, not handed to an agent;
         # an offered action answered «так» waits for the runner to act on it first.
+        problem = leave_problem(task) if task.answered and not task.closes and not task.decided else ""
+        if problem:
+            leave_note(path, task, problem)
+            continue
         if task.answered and not task.closes and not task.decided:
             target = board.tasks / "todo" / path.name
             target.parent.mkdir(parents=True, exist_ok=True)
