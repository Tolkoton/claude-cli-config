+SKETCH_PATH_RE = re.compile(rf"(?:(?<![\w./-])|{SHELL_VALUE}[\"']?/)(?:\.{{1,2}}/)*sketches/[A-Za-z0-9_.-]+")
+
+
+def sketch_mode(root: Path) -> bool:
+    """The session's task in doing/ is in the mode ескіз, as its one reader says (mode.py)."""
