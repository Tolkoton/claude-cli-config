{
 "hook": "overseer_verdict.py",
 "event": "SubagentStop of the agent `overseer` (wiring proposed in docs/tasks/settings.json, board 018)",
 "args": [
  "record"
 ],
 "scenarios": [
  {
   "id": "ovr-verdict-in-the-schema-is-recorded",
   "why": "A verdict that fits the schema is written by the script; the agent ends.",
   "setup": [
    {
     "write": {
      "path": ".claude/state/overseer/pending.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"unit_key\": \"-|-|unit 3\", \"asks\": 1, \"schema_errors\": 0, \"launched\": 1}\n"
     }
    },
    {
     "write": {
      "path": ".claude/state/overseer/requests/20261003T120000Z-abc123/request.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"slice\": \"unknown\", \"unit\": \"3\", \"unit_key\": \"-|-|unit 3\", \"attempt\": 1, \"contract\": null, \"passes_in_a_row\": 0, \"tree\": null}\n"
     }
    }
   ],
   "input": {
    "hook_event_name": "SubagentStop",
    "agent_type": "overseer",
    "agent_id": "a1",
    "last_assistant_message": "```json\n{\"verdict\": \"PASS\", \"check\": null, \"reason\": \"every claim has its evidence\", \"evidence\": [\"command: uv run pytest -q \\u2192 6 passed\"], \"category\": \"none\"}\n```"
   },
   "expect": "allow"
  },
  {
   "id": "ovr-off-schema-goes-back-to-the-agent",
   "why": "A BLOCK that names no check is sent back to the agent once.",
   "setup": [
    {
     "write": {
      "path": ".claude/state/overseer/pending.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"unit_key\": \"-|-|unit 3\", \"asks\": 1, \"schema_errors\": 0, \"launched\": 1}\n"
     }
    },
    {
     "write": {
      "path": ".claude/state/overseer/requests/20261003T120000Z-abc123/request.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"slice\": \"unknown\", \"unit\": \"3\", \"unit_key\": \"-|-|unit 3\", \"attempt\": 1, \"contract\": null, \"passes_in_a_row\": 0, \"tree\": null}\n"
     }
    }
   ],
   "input": {
    "hook_event_name": "SubagentStop",
    "agent_type": "overseer",
    "agent_id": "a1",
    "last_assistant_message": "{\"verdict\": \"BLOCK\", \"reason\": \"weak test\", \"evidence\": [\"command: pytest \\u2192 1 passed\"]}"
   },
   "expect": "block",
   "expect_detail_contains": "VERDICT REFUSED"
  },
  {
   "id": "ovr-off-schema-twice-is-invalid",
   "why": "The second answer off the schema is recorded INVALID and the agent ends: no loop.",
   "setup": [
    {
     "write": {
      "path": ".claude/state/overseer/pending.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"unit_key\": \"-|-|unit 3\", \"asks\": 1, \"schema_errors\": 1, \"launched\": 1}\n"
     }
    },
    {
     "write": {
      "path": ".claude/state/overseer/requests/20261003T120000Z-abc123/request.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"slice\": \"unknown\", \"unit\": \"3\", \"unit_key\": \"-|-|unit 3\", \"attempt\": 1, \"contract\": null, \"passes_in_a_row\": 0, \"tree\": null}\n"
     }
    }
   ],
   "input": {
    "hook_event_name": "SubagentStop",
    "agent_type": "overseer",
    "agent_id": "a1",
    "last_assistant_message": "Looks fine to me."
   },
   "expect": "allow"
  },
  {
   "id": "ovr-cited-line-must-exist",
   "why": "Evidence that cites a file:line which does not exist is refused: the citation is checked by the script.",
   "setup": [
    {
     "write": {
      "path": ".claude/state/overseer/pending.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"unit_key\": \"-|-|unit 3\", \"asks\": 1, \"schema_errors\": 0, \"launched\": 1}\n"
     }
    },
    {
     "write": {
      "path": ".claude/state/overseer/requests/20261003T120000Z-abc123/request.json",
      "content": "{\"id\": \"20261003T120000Z-abc123\", \"origin\": \"hook\", \"slice\": \"unknown\", \"unit\": \"3\", \"unit_key\": \"-|-|unit 3\", \"attempt\": 1, \"contract\": null, \"passes_in_a_row\": 0, \"tree\": null}\n"
     }
    }
   ],
   "input": {
    "hook_event_name": "SubagentStop",
    "agent_type": "overseer",
    "agent_id": "a1",
    "last_assistant_message": "{\"verdict\": \"BLOCK\", \"check\": 4, \"reason\": \"masked test gap\", \"evidence\": [\"tests/test_nowhere.py:12\"]}"
