{
  "hook": "overseer_stop.py",
  "event": "Stop — the overseer is a separate agent (board 018), and the only protocol (board 033): every scenario wires overseer_verdict.py in .claude/settings.local.json, except the two that show a project without the handlers",
  "scenarios": [
    {
      "id": "osf-unit-complete-requests-the-agent",
      "why": "Sentinel + code edit + verification command: the builder is told to launch the overseer agent with the request line — it does not audit itself.",
      "setup": [
        {
          "write": {
            "path": ".claude/settings.local.json",
            "content": "{\"hooks\": {\"SubagentStop\": [{\"matcher\": \"overseer\", \"hooks\": [{\"type\": \"command\", \"command\": \"python3 \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/overseer_verdict.py\\\" record\"}]}]}}\n"
          }
        }
      ],
      "transcript": [
        {
          "type": "user",
          "message": {
            "role": "user",
            "content": "Add with_tax to pricing and finish unit 3."
          }
        },
        {
          "type": "assistant",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "t0",
                "name": "Edit",
                "input": {
                  "file_path": "{{SANDBOX}}/src/refproj/pricing.py",
                  "old_string": "a",
                  "new_string": "b"
                }
              }
            ]
          }
        },
        {
          "type": "user",
          "message": {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "t0",
                "content": "ok"
              }
            ]
          }
        },
        {
          "type": "assistant",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "t1",
                "name": "Bash",
                "input": {
                  "command": "uv run pytest -x -q"
                }
              }
            ]
          }
        },
        {
          "type": "user",
          "message": {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "t1",
                "content": "ok"
              }
            ]
          }
        },
        {
          "type": "assistant",
          "message": {
            "role": "assistant",
            "content": [
              {
