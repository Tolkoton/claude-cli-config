{
  "hook": "auto-approve-web.py",
  "event": "PreToolUse + PermissionRequest (WebFetch|WebSearch)",
  "scenarios": [
    {
      "id": "aw-webfetch",
      "why": "Read-only web access is approved without a prompt.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "WebFetch",
        "tool_input": {
          "url": "https://docs.python.org/3/library/decimal.html",
          "prompt": "rounding modes"
        }
      },
      "expect": "allow-explicit"
    },
    {
      "id": "aw-websearch",
      "why": "Same for search.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "WebSearch",
        "tool_input": {
          "query": "python decimal ROUND_HALF_UP"
        }
      },
      "expect": "allow-explicit"
    },
    {
      "id": "aw-permission-request",
      "why": "The second wiring: the PermissionRequest event.",
      "input": {
        "hook_event_name": "PermissionRequest",
        "tool_name": "WebFetch",
        "tool_input": {
          "url": "https://docs.python.org/3/library/decimal.html"
        }
      },
      "expect": "allow-explicit"
    }
  ]
}
