{
  "hook": "protect-paths.sh",
  "event": "PreToolUse (Edit|Write|MultiEdit)",
  "scenarios": [
    {
      "id": "pp-dotenv",
      "why": "Secrets file. Before 2026-08-27 this deny was emitted as malformed JSON and lost.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.env"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-dotenv-variant",
      "why": ".env.local and friends.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.env.local"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-project-env-allowed",
      "why": "S5: the engine's own committed, secret-free config must stay writable.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.claude/project.env"
        }
      },
      "expect": "allow"
    },
    {
      "id": "pp-project-env-near-miss",
      "why": "The allowlist is $-anchored; a lookalike is still denied.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.claude/project.env.bak"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-settings-json",
      "why": "An agent must not widen its own permissions.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.claude/settings.json"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-settings-local-json",
      "why": "The quiet way to re-widen permissions.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.claude/settings.local.json"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-constitution",
      "why": "Human-only file (Article VII).",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.claude/constitution.md"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-rules-edit",
      "why": "Board 054: CLAUDE.md imports the rules file; a line lands there only through lesson_queue.py promote on the owner's answer. Edit.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.engine/rules.md"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-rules-write",
      "why": "Board 054: CLAUDE.md imports the rules file; a line lands there only through lesson_queue.py promote on the owner's answer. Write.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.engine/rules.md"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-rules-relative",
      "why": "Board 054: CLAUDE.md imports the rules file; a line lands there only through lesson_queue.py promote on the owner's answer. A relative path.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": ".engine/rules.md"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-lesson-queue-allowed",
      "why": "Board 054, negative: the lesson queue beside the rules file stays writable.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.engine/lesson-queue.md"
        }
      },
      "expect": "allow"
    },
    {
      "id": "pp-engine-rules-near-miss",
      "why": "Board 054, negative: .claude/engine-rules.md is another file.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.claude/engine-rules.md"
        }
      },
      "expect": "allow"
    },
    {
      "id": "pp-ci-workflow",
      "why": "CI definitions are the owner's.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.github/workflows/ci.yml"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-migration",
      "why": "Migrations are append-only history.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/migrations/0001_initial.py"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-ssh-key",
      "why": "Key material anywhere on disk.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "/home/someone/.ssh/id_ed25519"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-git-internals",
      "why": "The object store is not a file to edit.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/.git/config"
        }
      },
      "expect": "block"
    },
    {
      "id": "pp-source-file",
      "why": "Ordinary code must stay writable.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/src/refproj/pricing.py"
        }
      },
      "expect": "allow"
    },
    {
      "id": "pp-readme",
      "why": "Ordinary docs must stay writable.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/README.md"
        }
      },
      "expect": "allow"
    },
    {
      "id": "pp-overseer-edit",
      "why": "Board 055: the overseer agent is read-only. An Edit of a test inside the agent (it was overseer_verdict.py's guard that refused this).",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{{SANDBOX}}/tests/test_pricing.py",
          "old_string": "a",
          "new_string": "b"
        },
        "agent_type": "overseer",
        "agent_id": "a1"
      },
      "expect": "block",
      "expect_detail_contains": "read-only"
    },
    {
      "id": "pp-overseer-write-new-file",
      "why": "Board 055: the overseer agent is read-only. A Write of a new file.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{SANDBOX}}/src/refproj/extra.py"
        },
        "agent_type": "overseer",
        "agent_id": "a1"
      },
      "expect": "block",
      "expect_detail_contains": "read-only"
    },
    {
      "id": "pp-overseer-write-under-tmp",
      "why": "Board 055: the overseer agent is read-only. An editing tool is refused whatever the path; a copy under /tmp is made with a shell command.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "/tmp/audit-copy/a.py"
        },
        "agent_type": "overseer",
        "agent_id": "a1"
      },
      "expect": "block",
      "expect_detail_contains": "read-only"
    },
    {
      "id": "pp-overseer-notebook",
      "why": "Board 055: the overseer agent is read-only. NotebookEdit names its file in notebook_path.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "NotebookEdit",
        "tool_input": {
          "notebook_path": "{{SANDBOX}}/analysis.ipynb"
        },
        "agent_type": "overseer",
        "agent_id": "a1"
      },
      "expect": "block",
      "expect_detail_contains": "read-only"
    },
    {
      "id": "pp-another-agent-edit-allowed",
      "why": "Board 055, negative: another agent's edit of a source file is judged as a builder's.",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "{{SANDBOX}}/src/refproj/pricing.py"
        },
        "agent_type": "slice-builder",
        "agent_id": "b1"
      },
      "expect": "allow"
    }
  ]
}
